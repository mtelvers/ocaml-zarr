depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1"}
  "zarr" {= version}
  "s3"
  "eio" {>= "1.0"}
  "eio_main" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mtelvers/ocaml-zarr.git"
